__DOMAIN__ {
	encode zstd gzip

	# Security headers for every response (the app loads only its own scripts, styles and self-hosted fonts)
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Strict-Transport-Security "max-age=31536000"
		Permissions-Policy "geolocation=(), camera=(), microphone=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://basemaps.cartocdn.com https://*.basemaps.cartocdn.com https://tile.openstreetmap.org https://server.arcgisonline.com; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'"
		-Server
	}

	# PWA: the service worker script is always re-checked, and the manifest has its own media type
	@sw path /sw.js /asset-list.json /index.html
	header @sw Cache-Control "no-cache"
	# hashed build files never change: the browser keeps them for a year
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@manifest path /manifest.webmanifest
	header @manifest Content-Type "application/manifest+json"

	# Machine-to-machine sync: bypasses the web login but is protected by a bearer token
	# checked in the app (constant-time compare, throttled). POST only, exact path.
	@ingest {
		method POST
		path /api/ingest
	}
	handle @ingest {
		reverse_proxy 127.0.0.1:8787
	}
	# read-only sync status (counts and dates only), bearer-token protected in the app
	@istatus {
		method GET
		path /api/ingest/status
	}
	handle @istatus {
		reverse_proxy 127.0.0.1:8787
	}

	# PWA install files must load WITHOUT the login: browsers fetch the manifest, service worker and icons
	# without credentials, and a 401 there makes "Add to Home screen" create a plain browser shortcut
	# (address bar + toolbar) instead of a standalone app. They contain no personal data.
	@pwa path /manifest.webmanifest /sw.js /asset-list.json /icons/*
	handle @pwa {
		root * /opt/lumpad/dist
		file_server
	}

	# Everything else: web login
	handle {
		basicauth {
			__USER__ __HASH__
		}
		handle /api/v2/* {
			reverse_proxy 127.0.0.1:8788
		}
		handle /api/* {
			reverse_proxy 127.0.0.1:8787
		}
		handle {
			root * /opt/lumpad/dist
			try_files {path} /index.html
			file_server
		}
	}
}
