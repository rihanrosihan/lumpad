{
 "type": "object",
 "required": [
  "summary",
  "analysis_md",
  "recommendations",
  "flags",
  "memory_writes",
  "cited_ids"
 ],
 "properties": {
  "summary": {
   "type": "string",
   "maxLength": 900
  },
  "analysis_md": {
   "type": "string",
   "maxLength": 3000
  },
  "recommendations": {
   "type": "array",
   "maxItems": 8,
   "items": {
    "type": "object",
    "required": [
     "action",
     "why",
     "priority"
    ],
    "properties": {
     "action": {
      "type": "string",
      "maxLength": 400
     },
     "why": {
      "type": "string",
      "maxLength": 500
     },
     "priority": {
      "type": "string",
      "enum": [
       "now",
       "this_week",
       "later"
      ]
     },
     "evidence_ids": {
      "type": "array",
      "items": {
       "type": "integer"
      }
     },
     "needs_athlete_ok": {
      "type": "boolean"
     },
     "target": {
      "type": "object",
      "properties": {
       "for_date": {
        "type": "string"
       },
       "kind": {
        "type": "string",
        "enum": [
         "session",
         "rest",
         "cap",
         "fuel",
         "volume",
         "strength",
         "other"
        ]
       },
       "km": {
        "type": "number"
       },
       "hr_cap_bpm": {
        "type": "number"
       }
      }
     }
    }
   }
  },
  "flags": {
   "type": "array",
   "maxItems": 8,
   "items": {
    "type": "object",
    "required": [
     "type",
     "text"
    ],
    "properties": {
     "type": {
      "type": "string",
      "enum": [
       "gate",
       "injury",
       "load",
       "heat",
       "data_gap",
       "rule",
       "other"
      ]
     },
     "text": {
      "type": "string",
      "maxLength": 300
     }
    }
   }
  },
  "memory_writes": {
   "type": "array",
   "maxItems": 5,
   "items": {
    "type": "object",
    "required": [
     "tier",
     "title",
     "body",
     "cites"
    ],
    "properties": {
     "tier": {
      "type": "string",
      "enum": [
       "episodic",
       "semantic",
       "procedural"
      ]
     },
     "kind": {
      "type": "string",
      "maxLength": 30
     },
     "title": {
      "type": "string",
      "maxLength": 140
     },
     "body": {
      "type": "string",
      "maxLength": 900
     },
     "cites": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "integer"
      }
     },
     "tags": {
      "type": "array",
      "maxItems": 8,
      "items": {
       "type": "string",
       "maxLength": 40
      }
     },
     "confidence": {
      "type": "number"
     }
    }
   }
  },
  "cited_ids": {
   "type": "array",
   "items": {
    "type": "integer"
   }
  },
  "twin_state_patch": {
   "type": "object",
   "properties": {
    "current_ef_baseline": {
     "type": "number"
    },
    "shoe_alert": {
     "type": "string",
     "maxLength": 300
    },
    "readiness_modifier": {
     "type": "string",
     "maxLength": 300
    }
   }
  }
 }
}
